# Образец. Скопируйте в .env и заполните настоящими значениями:
#   copy .env.example .env

MSSQL_SA_PASSWORD=ПРИДУМАЙТЕ_СЛОЖНЫЙ_ПАРОЛЬ_Аа1!
JWT_KEY=СЛУЧАЙНАЯ_СТРОКА_НЕ_КОРОЧЕ_32_СИМВОЛОВ
SEED_ADMIN_EMAIL=admin@lms.com
SEED_ADMIN_PASSWORD=ПРИДУМАЙТЕ_ПАРОЛЬ
SEED_DEMO_PASSWORD=ПРИДУМАЙТЕ_ПАРОЛЬ

# Для восстановления пароля по email через Gmail SMTP.
# EMAIL_SENDER_APP_PASSWORD — НЕ обычный пароль от Gmail, а отдельный
# "пароль приложения" (см. README, раздел про настройку почты).
EMAIL_SENDER_ADDRESS=ваш_адрес@gmail.com
EMAIL_SENDER_APP_PASSWORD=ПАРОЛЬ_ПРИЛОЖЕНИЯ_GMAIL

# MinIO — файловое хранилище (аватары, PDF-сертификаты, материалы уроков).
MINIO_ROOT_USER=ПРИДУМАЙТЕ_ЛОГИН
MINIO_ROOT_PASSWORD=ПРИДУМАЙТЕ_ПАРОЛЬ_НЕ_КОРОЧЕ_8_СИМВОЛОВ
