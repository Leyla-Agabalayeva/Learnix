[Rr]elease/
*.user
*.suo

# ---------------------------------------------------------------------------
# Visual Studio
# ---------------------------------------------------------------------------
.vs/
*.userprefs
*.DotSettings.user

# ---------------------------------------------------------------------------
# СЕКРЕТЫ — самое важное в этом файле
#
# appsettings.Development.json содержит строку подключения к базе, ключ
# подписи JWT и пароль администратора. Один раз попав в историю git, они
# останутся в ней навсегда даже после удаления файла: придётся переписывать
# историю. Поэтому файл исключён С САМОГО ПЕРВОГО КОММИТА.
#
# Вместо него в репозитории лежит appsettings.Development.example.json —
# та же структура с пустыми значениями, по нему видно, что нужно заполнить.
# ---------------------------------------------------------------------------
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
*.pfx
secrets.json

# Docker Compose: те же пароли и JWT-ключ, только в другом формате.
# .env содержит настоящие значения — не в git. .env.example (шаблон
# с пустыми подсказками) — в git, по нему видно, что нужно заполнить.
.env

# Загруженные пользователями аватары — не демо-данные, каждому окружению свои.
LMSFinal.WebApi/wwwroot/uploads/

